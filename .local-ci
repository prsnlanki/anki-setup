#!/usr/bin/env bash
# The checks every change must pass, run on this machine by `local-ci` (claude-toolkit)
# in place of GitHub Actions. Run it directly to check without posting a status.
# The decks live in their own repositories (see README.md) and run their own checks.
set -euo pipefail
cd "$(dirname "$0")"
git submodule update --init -q
for f in addons/*/; do [ -n "$(ls -A "$f")" ] || { echo "$f is empty" >&2; exit 1; }; done
echo "submodules present"
